# Add to nginx's http context only after inspecting the existing virtual hosts.
# Certbot >= 5.4; keep the HTTP challenge location for automated short-lived IP renewal.
# Bootstrap with the port 80 block first; add 443 after the certificate exists.
server {
    listen 80;
    server_name 8.133.216.39;
    access_log off;
    error_log /var/log/nginx/yigame-error.log warn;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/yigame-acme;
        try_files $uri =404;
    }
    location / { return 308 https://8.133.216.39$request_uri; }
}

server {
    listen 443 ssl;
    server_name 8.133.216.39;
    ssl_certificate /etc/letsencrypt/live/yigame-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yigame-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/yigame-error.log warn;
    client_max_body_size 8k;
    client_body_timeout 15s;

    location ~ ^/api/v1/admin(?:/|$) { return 404; }
    location = /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_read_timeout 20s;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_read_timeout 20s;
    }
    root /opt/yigame/web;
    index index.html;
    include /etc/nginx/mime.types;
    gzip on;
    gzip_types application/wasm application/javascript application/json text/css;
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
