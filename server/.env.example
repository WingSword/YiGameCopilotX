# Generate a unique value: openssl rand -hex 32
ADMIN_TOKEN=
BIND_ADDRESS=127.0.0.1
# Optional exact origins for cross-origin Web hosting, comma separated; same-origin proxy needs none.
WEB_ORIGINS=
# Public Web entry served by your HTTPS proxy; its origin must proxy /api to this server.
# Example: https://play.example.com/ (the native default HTTP endpoint remains unchanged).
PUBLIC_WEB_URL=
