<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep keys and room sessions out of both cloud and device-transfer backups. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
